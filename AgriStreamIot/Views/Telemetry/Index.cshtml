@model List<AgriStreamIoT.Models.TelemetryReading>

@{
    ViewData["Title"] = "Farm Telemetry";
    Layout = null;

    var latest = Model.FirstOrDefault();
    var averageTemperature = Model.Any()
        ? Model.Average(x => x.TemperatureCelsius)
        : 0;

    var averageMoisture = Model.Any()
        ? Model.Average(x => x.SoilMoisture)
        : 0;

    var averageHumidity = Model.Any()
        ? Model.Average(x => x.HumidityPercent)
        : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AgriStream IoT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
</head>

<body class="bg-light">

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-leaf text-success me-2"></i>
                AgriStream IoT
            </a>

            <a asp-controller="Home" asp-action="Index"
               class="btn btn-outline-light btn-sm">
                <i class="fa-solid fa-arrow-left me-2"></i> Dashboard
            </a>
        </div>
    </nav>

    <main class="container py-5">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-warning">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @TempData["Error"]
            </div>
        }

        <div class="mb-4">
            <h2 class="fw-bold">
                <i class="fa-solid fa-satellite-dish text-success me-2"></i>
                Farm Telemetry
            </h2>
            <p class="text-muted">
                Monitor environmental conditions and sensor readings across your fields.
            </p>
        </div>

        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="text-muted mb-2">
                            <i class="fa-solid fa-temperature-half me-2"></i>
                            Average Temperature
                        </div>
                        <h3 class="fw-bold">
                            @averageTemperature.ToString("0.0") °C
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="text-muted mb-2">
                            <i class="fa-solid fa-droplet me-2"></i>
                            Average Soil Moisture
                        </div>
                        <h3 class="fw-bold">
                            @averageMoisture.ToString("0.0") %
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="text-muted mb-2">
                            <i class="fa-solid fa-cloud-rain me-2"></i>
                            Average Humidity
                        </div>
                        <h3 class="fw-bold">
                            @averageHumidity.ToString("0.0") %
                        </h3>
                    </div>
                </div>
            </div>

        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-header bg-white border-0 p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Recent Sensor Readings</h5>
                        <small class="text-muted">
                            Latest readings retrieved from Azure Table Storage
                        </small>
                    </div>

                    <span class="badge bg-success">
                        @Model.Count readings
                    </span>
                </div>
            </div>

            <div class="card-body p-0">

                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Field</th>
                                    <th>Device</th>
                                    <th>Temperature</th>
                                    <th>Soil Moisture</th>
                                    <th>Humidity</th>
                                    <th>Recorded At (UTC)</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var reading in Model)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold">
                                            @reading.FieldId
                                        </td>
                                        <td>@reading.DeviceId</td>
                                        <td>
                                            <i class="fa-solid fa-temperature-half text-danger me-1"></i>
                                            @reading.TemperatureCelsius.ToString("0.0") °C
                                        </td>
                                        <td>
                                            <i class="fa-solid fa-droplet text-primary me-1"></i>
                                            @reading.SoilMoisture.ToString("0.0") %
                                        </td>
                                        <td>
                                            @reading.HumidityPercent.ToString("0.0") %
                                        </td>
                                        <td class="text-muted small">
                                            @(reading.RecordedAtUtc == DateTime.MinValue
                                                ? "Unknown"
                                                : reading.RecordedAtUtc.ToString("dd MMM yyyy HH:mm:ss"))
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fa-solid fa-chart-line fs-1 text-muted mb-3"></i>
                        <h5 class="fw-bold">No telemetry available</h5>
                        <p class="text-muted mb-0">
                            Sensor readings will appear here once data is added to Azure Table Storage.
                        </p>
                    </div>
                }

            </div>
        </div>

        <div class="mt-3 text-muted small">
            <i class="fa-solid fa-cloud me-1"></i>
            Data source: Azure Table Storage — Telemetry
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>