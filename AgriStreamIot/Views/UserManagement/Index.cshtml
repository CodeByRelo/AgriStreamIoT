@model List<AgriStreamIoT.ViewModels.UserListViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">User Management</h2>
            <p class="text-muted mb-0">Manage system accounts and permissions.</p>
        </div>

        <a asp-action="Create" class="btn btn-dark">
            <i class="fas fa-user-plus me-2"></i>Create User
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Username</th>
                            <th>Role</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@user.Username</td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit"
                                       asp-route-id="@user.UserId"
                                       class="btn btn-sm btn-outline-dark">
                                        <i class="fas fa-edit me-1"></i>Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <p class="text-muted text-center py-4">No users found.</p>
            }
        </div>
    </div>
</div>
