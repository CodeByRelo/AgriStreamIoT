@{
    Layout = null;
    ViewData["Title"] = "Access Denied";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriStream IoT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
            body {
                min-height: 100vh;
                background: #f5f7f2;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: Arial, sans-serif;
                padding: 24px;
            }

            .access-card {
                background: #fff;
                border-radius: 22px;
                max-width: 520px;
                width: 100%;
                padding: 48px 40px;
                text-align: center;
                box-shadow: 0 15px 45px rgba(22, 48, 32, 0.08);
            }

            .brand {
                color: #183d2b;
                font-size: 22px;
                font-weight: 800;
                margin-bottom: 38px;
            }

                .brand i {
                    color: #91b83f;
                    margin-right: 8px;
                }

            .icon-circle {
                width: 100px;
                height: 100px;
                border-radius: 50%;
                background: #fff0e8;
                color: #dc713d;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 40px;
                margin: 0 auto 26px;
            }

            h1 {
                color: #183d2b;
                font-size: 30px;
                font-weight: 800;
                margin-bottom: 14px;
            }

            .description {
                color: #737d75;
                font-size: 15px;
                line-height: 1.7;
                margin-bottom: 30px;
            }

            .btn-primary-custom {
                background: #244d35;
                color: #fff;
                border: none;
                border-radius: 9px;
                padding: 13px 24px;
                font-weight: 600;
                transition: 0.2s ease;
            }

                .btn-primary-custom:hover {
                    background: #183d2b;
                    color: #fff;
                    transform: translateY(-2px);
                }

            .btn-secondary-custom {
                color: #526257;
                font-weight: 600;
                text-decoration: none;
                display: inline-block;
                margin-top: 18px;
            }

                .btn-secondary-custom:hover {
                    color: #244d35;
                }

            .footer-text {
                color: #a0aaa2;
                font-size: 12px;
                margin-top: 38px;
            }

            @@media (max-width: 576px) {
                .access-card {
                    padding: 38px 24px;
                }

                h1 {
                    font-size: 25px;
                }
            }
    </style>
</head>

<body>
    <div class="access-card">

        <div class="brand">
            <i class="fa-solid fa-leaf"></i>
            AgriStream <span class="fw-normal">IoT</span>
        </div>

        <div class="icon-circle">
            <i class="fa-solid fa-lock"></i>
        </div>

        <h1>Access Restricted</h1>

        <p class="description">
            You don't have the necessary permissions to access this page.
            Your account may not have the required role or access privileges.
            If you believe this is a mistake, please contact your system administrator.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary-custom">
            <i class="fa-solid fa-house me-2"></i>
            Return to Dashboard
        </a>

        <div>
            <a asp-controller="Account"
               asp-action="Logout"
               class="btn-secondary-custom">
                <i class="fa-solid fa-right-from-bracket me-1"></i>
                Sign out
            </a>
        </div>

        <div class="footer-text">
            &copy; @DateTime.Now.Year AgriStream IoT. All rights reserved.
        </div>

    </div>
</body>
</html>
