@{
    ViewData["Title"] = "Welcome to AgriStream IoT";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
            :root {
                --forest: #142d24;
                --forest-light: #1d4031;
                --lime: #b7e36b;
                --muted: #a8b7ae;
                --surface: #ffffff;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: 'Segoe UI', sans-serif;
                background: #f4f6f2;
            }

            .page-wrapper {
                min-height: 100vh;
                display: flex;
            }

            /* LEFT HERO SECTION */

            .hero-section {
                flex: 1.15;
                position: relative;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 55px 7%;
                overflow: hidden;
                color: white;
                background:
                    linear-gradient(110deg, rgba(10, 35, 25, .96), rgba(15, 49, 34, .83)),
                    url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1800&q=85')
                    center/cover;
            }

            .hero-section::after {
                content: "";
                position: absolute;
                width: 450px;
                height: 450px;
                border: 1px solid rgba(183, 227, 107, .15);
                border-radius: 50%;
                right: -180px;
                bottom: -180px;
                box-shadow: 0 0 0 55px rgba(183, 227, 107, .035),
                            0 0 0 110px rgba(183, 227, 107, .025);
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 13px;
                position: relative;
                z-index: 2;
            }

            .brand-icon {
                width: 46px;
                height: 46px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--lime);
                color: var(--forest);
                border-radius: 13px;
                font-size: 22px;
            }

            .brand-name {
                font-size: 21px;
                font-weight: 750;
                letter-spacing: -.6px;
            }

            .brand-name span {
                color: var(--lime);
            }

            .hero-content {
                position: relative;
                z-index: 2;
                max-width: 650px;
                margin: 60px 0;
            }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                color: var(--lime);
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
                margin-bottom: 25px;
            }

            .eyebrow-dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--lime);
            }

            .hero-content h1 {
                font-size: clamp(42px, 5vw, 68px);
                line-height: 1.08;
                font-weight: 750;
                letter-spacing: -2.5px;
                margin-bottom: 25px;
            }

            .hero-content h1 span {
                color: var(--lime);
            }

            .hero-description {
                color: #c1cec5;
                font-size: 16px;
                line-height: 1.9;
                max-width: 540px;
            }

            .feature-list {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
                margin-top: 35px;
            }

            .feature-item {
                padding: 11px 15px;
                border: 1px solid rgba(255,255,255,.16);
                border-radius: 8px;
                color: #e0e9e3;
                font-size: 12px;
                background: rgba(255,255,255,.055);
            }

            .feature-item i {
                color: var(--lime);
                margin-right: 7px;
            }

            .hero-footer {
                position: relative;
                z-index: 2;
                color: #9bad9f;
                font-size: 12px;
            }

            /* RIGHT LOGIN SECTION */

            .login-section {
                flex: .85;
                min-width: 430px;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 45px;
                background: #f7f8f5;
            }

            .login-card {
                width: 100%;
                max-width: 420px;
            }

            .mobile-brand {
                display: none;
            }

            .login-heading {
                margin-bottom: 35px;
            }

            .login-heading .welcome {
                color: #829086;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1.7px;
                text-transform: uppercase;
            }

            .login-heading h2 {
                color: #1a3026;
                font-size: 34px;
                font-weight: 750;
                letter-spacing: -1px;
                margin: 12px 0;
            }

            .login-heading p {
                color: #7c887f;
                font-size: 14px;
            }

            .form-label {
                font-size: 13px;
                color: #34483b;
                font-weight: 650;
                margin-bottom: 9px;
            }

            .form-control {
                height: 52px;
                border: 1px solid #e0e5df;
                border-radius: 9px;
                padding: 12px 15px;
                font-size: 14px;
                background: #fff;
            }

            .form-control:focus {
                border-color: #82ad54;
                box-shadow: 0 0 0 3px rgba(130, 173, 84, .13);
            }

            .input-group-text {
                background: white;
                border: 1px solid #e0e5df;
                border-right: 0;
                color: #819086;
                border-radius: 9px 0 0 9px;
            }

            .input-group .form-control {
                border-left: 0;
                border-radius: 0 9px 9px 0;
            }

            .login-button {
                height: 52px;
                width: 100%;
                border: none;
                border-radius: 9px;
                background: var(--forest);
                color: white;
                font-size: 14px;
                font-weight: 700;
                transition: .2s ease;
            }

            .login-button:hover {
                background: #244c37;
                color: white;
                transform: translateY(-1px);
            }

            .login-button i {
                color: var(--lime);
                margin-left: 9px;
            }

            .security-note {
                margin-top: 25px;
                padding: 14px;
                background: #edf3e9;
                border-radius: 9px;
                color: #657966;
                font-size: 12px;
                line-height: 1.6;
            }

            .security-note i {
                color: #547d3c;
                margin-right: 7px;
            }

            .login-footer {
                margin-top: 45px;
                text-align: center;
                color: #9aa49b;
                font-size: 11px;
            }

            .validation-summary-errors {
                color: #b42318;
                font-size: 13px;
                margin-bottom: 18px;
            }

            .validation-summary-errors ul {
                margin-bottom: 0;
                padding-left: 20px;
            }

            @@media (max-width: 900px) {
                .hero-section {
                    display: none;
                }

                .login-section {
                    min-width: 0;
                    flex: 1;
                    padding: 30px 22px;
                }

                .mobile-brand {
                    display: flex;
                    margin-bottom: 45px;
                }
            }
    </style>
</head>

<body>
    <div class="page-wrapper">

        <!-- HERO SECTION -->
        <section class="hero-section">

            <div class="brand">
                <div class="brand-icon">
                    <i class="fa-solid fa-leaf"></i>
                </div>

                <div class="brand-name">
                    AgriStream<span>IoT</span>
                </div>
            </div>

            <div class="hero-content">

                <div class="eyebrow">
                    <span class="eyebrow-dot"></span>
                    SMART AGRICULTURE. CONNECTED FUTURES.
                </div>

                <h1>
                    Smarter farms.<br />
                    <span>Better decisions.</span>
                </h1>

                <p class="hero-description">
                    AgriStream IoT brings agricultural intelligence into
                    one connected platform. Monitor field conditions,
                    track sensor activity, manage irrigation operations
                    and access valuable farm insights in real time.
                </p>

                <div class="feature-list">
                    <div class="feature-item">
                        <i class="fa-solid fa-satellite-dish"></i>
                        Live Sensor Monitoring
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        Drone Image Management
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-droplet"></i>
                        Smart Irrigation
                    </div>

                    <div class="feature-item">
                        <i class="fa-solid fa-chart-line"></i>
                        Agricultural Insights
                    </div>
                </div>

            </div>

            <div class="hero-footer">
                © @DateTime.Now.Year AgriStream IoT. Intelligent agriculture, connected.
            </div>

        </section>

        <!-- LOGIN SECTION -->
        <section class="login-section">

            <div class="login-card">

                <div class="brand mobile-brand">
                    <div class="brand-icon">
                        <i class="fa-solid fa-leaf"></i>
                    </div>

                    <div class="brand-name" style="color:#142d24">
                        AgriStream<span>IoT</span>
                    </div>
                </div>

                <div class="login-heading">
                    <div class="welcome">YOUR FARM. YOUR DATA. YOUR CONTROL.</div>

                    <h2>Welcome back.</h2>

                    <p>Sign in to access your AgriStream workspace.</p>
                </div>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary-errors"></div>

                    <div class="mb-4">
                        <label for="username" class="form-label">
                            Username
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fa-regular fa-user"></i>
                            </span>

                            <input type="text"
                                   id="username"
                                   name="username"
                                   class="form-control"
                                   placeholder="Enter your username"
                                   autocomplete="username"
                                   required />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label">
                            Password
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fa-solid fa-lock"></i>
                            </span>

                            <input type="password"
                                   id="password"
                                   name="password"
                                   class="form-control"
                                   placeholder="Enter your password"
                                   autocomplete="current-password"
                                   required />
                        </div>
                    </div>

                    <button type="submit" class="login-button">
                        Sign in to AgriStream
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>

                </form>

                <div class="security-note">
                    <b>Demo Admin Login:</b> <br />
                    Username: AgriStream-Practicum <br/>
                    Password: Admin@123456 <br/><hr/>


                    <i class="fa-solid fa-shield-halved"></i>
                    Your workspace is protected with secure authentication.
                    Access to platform features depends on your assigned role.
                </div>

                <div class="login-footer">
                    AGRISTREAM IoT &nbsp;·&nbsp; POWERING INTELLIGENT AGRICULTURE
                </div>

            </div>

        </section>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
