@model AgriStreamIoT.ViewModels.IrrigationDashboardViewModel

@{
    ViewData["Title"] = "Irrigation Management";
    Layout = null;

    var onlineDevices = Model.Devices.Count(d =>
        d.OperationalStatus == "Online");

    var irrigatingDevices = Model.Devices.Count(d =>
        d.OperationalStatus == "Irrigating");

    var offlineDevices = Model.Devices.Count(d =>
        d.OperationalStatus == "Offline");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - AgriStream IoT</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />
</head>

<body class="bg-light">

    <main class="container py-4">

        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="fas fa-droplet text-success me-2"></i>
                    Irrigation Management
                </h2>
                <p class="text-muted mb-0">
                    Monitor devices and remotely manage irrigation operations.
                </p>
            </div>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Dashboard
            </a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle me-2"></i>
                @TempData["Success"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle me-2"></i>
                @TempData["Error"]
                <button type="button" class="btn-close"
                        data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted mb-1">Total devices</p>
                        <h3 class="fw-bold mb-0">@Model.Devices.Count</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted mb-1">Irrigating</p>
                        <h3 class="fw-bold text-success mb-0">
                            @irrigatingDevices
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <p class="text-muted mb-1">Offline</p>
                        <h3 class="fw-bold text-secondary mb-0">
                            @offlineDevices
                        </h3>
                    </div>
                </div>
            </div>

        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">
                    <i class="fas fa-sliders me-2 text-success"></i>
                    Send irrigation command
                </h5>
            </div>

            <div class="card-body">

                @if (Model.Devices.Any())
                {
                    <form asp-controller="Irrigation"
                          asp-action="SendCommand"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="row g-3 align-items-end">

                            <div class="col-md-5">
                                <label class="form-label fw-semibold">
                                    Select device
                                </label>

                                <select name="DeviceId"
                                        class="form-select"
                                        required>
                                    <option value="">Choose a device</option>

                                    @foreach (var device in Model.Devices)
                                    {
                                        <option value="@device.DeviceId">
                                            @device.FieldId - Device #@device.DeviceId
                                            (@device.OperationalStatus)
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    Command
                                </label>

                                <select name="Command" class="form-select">
                                    <option value="Start">Start irrigation</option>
                                    <option value="Stop">Stop irrigation</option>
                                </select>
                            </div>

                            <div class="col-md-3">
                                <button type="submit"
                                        class="btn btn-success w-100">
                                    <i class="fas fa-paper-plane me-2"></i>
                                    Send command
                                </button>
                            </div>

                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        No devices have been registered yet.
                    </div>
                }

            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Registered devices</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Device ID</th>
                            <th>Field</th>
                            <th>Operational status</th>
                            <th>Last updated</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var device in Model.Devices)
                        {
                            var statusClass = device.OperationalStatus switch
                            {
                                "Irrigating" => "success",
                                "Online" => "primary",
                                "Offline" => "secondary",
                                _ => "warning"
                            };

                            <tr>
                                <td class="fw-semibold">#@device.DeviceId</td>
                                <td>@device.FieldId</td>
                                <td>
                                    <span class="badge bg-@statusClass">
                                        @device.OperationalStatus
                                    </span>
                                </td>
                                <td>
                                    @device.LastUpdated.ToString("dd MMM yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
