@model List<AgriStreamIoT.ViewModels.DroneImageViewModel>

@{
    ViewData["Title"] = "Drone Images";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">
                <i class="fa-solid fa-images text-success me-2"></i>
                Drone Images
            </h2>
            <p class="text-muted mb-0">
                Upload and monitor agricultural drone imagery.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-5">
        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">Upload New Image</h5>

            <form asp-controller="DroneImages"
                  asp-action="Upload"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="file" class="form-label fw-semibold">
                        Select drone image
                    </label>

                    <input type="file"
                           id="file"
                           name="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp"
                           required />

                    <div class="form-text">
                        Supported formats: JPG, PNG and WEBP.
                        Maximum size: 10 MB.
                    </div>
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="fa-solid fa-cloud-arrow-up me-2"></i>
                    Upload to Azure
                </button>

            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Stored Images</h5>

        <span class="badge bg-success">
            @Model.Count images
        </span>
    </div>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Image</th>
                            <th>Processing Status</th>
                            <th>File Size</th>
                            <th>Processed At</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var image in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">
                                        <i class="fa-solid fa-file-image text-success me-2"></i>
                                        @image.BlobName
                                    </div>
                                    <small class="text-muted">
                                        Azure Blob Storage
                                    </small>
                                </td>

                                <td>
                                    @if (image.ProcessingStatus == "Processed")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fa-solid fa-circle-check me-1"></i>
                                            Processed
                                        </span>
                                    }
                                    else if (image.ProcessingStatus == "Failed")
                                    {
                                        <span class="badge bg-danger">
                                            Processing failed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fa-solid fa-clock me-1"></i>
                                            Awaiting processing
                                        </span>
                                    }

                                    <div class="small text-muted mt-1">
                                        @image.Message
                                    </div>
                                </td>

                                <td>
                                    @if (image.FileSizeBytes.HasValue &&
                                         image.FileSizeBytes.Value >= 0)
                                    {
                                        @($"{image.FileSizeBytes.Value / 1024.0:N1} KB")
                                    }
                                    else
                                    {
                                        <span class="text-muted">--</span>
                                    }
                                </td>

                                <td>
                                    @if (image.ProcessedAtUtc.HasValue)
                                    {
                                        @(image.ProcessedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm"))
                                    }
                                    else
                                    {
                                        <span class="text-muted">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fa-solid fa-cloud-arrow-up text-muted fs-1 mb-3"></i>

                <h6 class="fw-bold">No images uploaded yet</h6>

                <p class="text-muted mb-0">
                    Upload your first drone image to get started.
                </p>
            </div>
        </div>
    }

    <div class="mt-3 text-muted small">
        <i class="fa-solid fa-circle-info me-1"></i>
        Refresh this page to retrieve the latest processing status.
    </div>

</div>